---
// 親向け学習サマリ画面(将来の課金対象。今回は課金ゲートなし)。
// - 「時間・順位を子どもに見せない」は低学年向け表示ポリシーのため、親向けのこの画面では
//   回答時間を積極的に見せて、成長の根拠が伝わるようにする。
// - チャートはライブラリを使わず、src/lib/summary-charts.ts のモデルからJSXでSVGを組む
//   (set:html禁止の規約のため、文字列HTMLの注入はしない)。
// - 色・フォントは /skins/default/tokens.css のCSS変数のみを参照する(スキン規約)。
import {
  buildDailyActivity,
  buildMasteryCurve,
  buildSpeedTrend,
  buildWeakFacts,
  buildWeeklyHighlights,
  type SummaryLogRow,
} from '../lib/summary';
import { buildBarChart, buildLineChart } from '../lib/summary-charts';
import { createSupabaseServerClient } from '../lib/supabase';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect('/login');
}

// RLSにより自分の子だけが返る
const { data: children } = await supabase.from('children').select('id, name').order('created_at', { ascending: true });
if (!children || children.length === 0) {
  return Astro.redirect('/children');
}

const requestedChildId = Astro.url.searchParams.get('child');
const child = children.find((row) => row.id === requestedChildId) ?? children[0];

const { data: masteryRows, error: masteryError } = await supabase
  .from('multiplication_mastery')
  .select('problem_id, mastered, mastered_at')
  .eq('child_id', child.id);

if (masteryError) {
  console.error('習熟状況の取得に失敗しました', masteryError);
}

const { data: logRows, error: logsError } = await supabase
  .from('answer_logs')
  .select('problem_id, is_correct, started_at, completed_at, problems!inner(params, problem_templates!inner(shape_type))')
  .eq('child_id', child.id)
  .in('problems.problem_templates.shape_type', ['multiplication_fact', 'multiplication_missing_factor']);

if (logsError) {
  console.error('回答ログの取得に失敗しました', logsError);
}

const logs: SummaryLogRow[] = (logRows ?? []).map((row) => {
  const problem = row.problems as unknown as { params: unknown; problem_templates: { shape_type: string } };
  return {
    problem_id: row.problem_id as string,
    is_correct: row.is_correct as boolean,
    started_at: row.started_at as string,
    completed_at: row.completed_at as string,
    shape_type: problem.problem_templates.shape_type,
    params: problem.params,
  };
});

const today = new Date();
const masteredRows = (masteryRows ?? []).filter((row) => row.mastered && row.mastered_at);
const masteredAts = masteredRows.map((row) => row.mastered_at as string);
const masteredIds = new Set(masteredRows.map((row) => row.problem_id as string));

const curve = buildMasteryCurve(masteredAts, today);
const speed = buildSpeedTrend(logs, today);
const activity = buildDailyActivity(logs, today);
const weakFacts = buildWeakFacts(logs, masteredIds);
const highlights = buildWeeklyHighlights(masteredAts, logs, today);

// 「YYYY-MM-DD」→「M/D」
const shortDate = (key: string) => `${Number(key.slice(5, 7))}/${Number(key.slice(8, 10))}`;

const curveChart = buildLineChart(
  curve.map((point) => ({ label: shortDate(point.date), value: point.value })),
  'こ',
);
const speedChart = buildLineChart(
  speed.map((point) => ({ label: point.label, value: point.avgSeconds })),
  '秒',
);
const activityChart = buildBarChart(
  activity.days.map((day) => ({ label: shortDate(day.date), value: day.count })),
);

const totalMastered = masteredRows.length;
const totalAnswers28d = activity.days.reduce((sum, day) => sum + day.count, 0);
const latestSpeed = [...speed].reverse().find((point) => point.avgSeconds !== null)?.avgSeconds ?? null;
const hasAnyData = logs.length > 0;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>学習サマリ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/skins/default/tokens.css" />
    <style>
      body {
        margin: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-family);
        line-height: 1.7;
      }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
      }
      header h1 {
        font-size: 1.4rem;
        margin: 0.5rem 0 0.25rem;
      }
      .back-link,
      .note {
        color: var(--color-text-soft);
        font-size: 0.85rem;
      }
      a {
        color: var(--color-primary);
      }
      .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 1rem 0 1.5rem;
      }
      .tabs a {
        padding: 0.35rem 1rem;
        border-radius: 999px;
        background: var(--color-surface);
        box-shadow: var(--shadow-card);
        text-decoration: none;
        color: var(--color-text-soft);
      }
      .tabs a.active {
        background: var(--color-primary);
        color: var(--color-surface);
        font-weight: 700;
      }
      .card {
        background: var(--color-surface);
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
        padding: 1.25rem 1.25rem 1rem;
        margin-bottom: 1.25rem;
      }
      .card h2 {
        font-size: 1.05rem;
        margin: 0 0 0.25rem;
      }
      .headline {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--color-primary);
        margin: 0.25rem 0;
      }
      .headline small {
        font-size: 0.9rem;
        color: var(--color-text-soft);
        font-weight: 400;
      }
      .why {
        background: var(--color-primary-soft);
        border-radius: calc(var(--radius) / 2);
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
        margin-top: 0.75rem;
      }
      .chart {
        width: 100%;
        height: auto;
      }
      .chart-line {
        fill: none;
        stroke: var(--chart-line);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .chart-area {
        fill: var(--chart-fill);
      }
      .chart-grid {
        stroke: var(--chart-grid);
        stroke-width: 1;
      }
      .chart-dot {
        fill: var(--chart-line);
      }
      .chart-bar {
        fill: var(--chart-bar);
      }
      .chart-text {
        fill: var(--chart-label);
        font-size: 12px;
        font-family: var(--font-family);
      }
      .chart-value {
        fill: var(--chart-line);
        font-size: 14px;
        font-weight: 700;
        font-family: var(--font-family);
      }
      .weak-list {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
      }
      .weak-list li {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.5rem 0;
        border-bottom: 1px dashed var(--chart-grid);
      }
      .weak-list li:last-child {
        border-bottom: none;
      }
      .weak-meta {
        color: var(--color-text-soft);
        font-size: 0.85rem;
        white-space: nowrap;
      }
      .empty {
        color: var(--color-text-soft);
        background: var(--color-bg);
        border-radius: calc(var(--radius) / 2);
        padding: 1rem;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <p class="back-link"><a href="/children">← 子どもをえらぶ画面へ</a></p>
        <h1>{child.name}さんの学習サマリ</h1>
        <p class="note">かけ算(九九)の学習記録から、成長のようすをまとめています。</p>
      </header>

      <nav class="tabs">
        {children.map((row) => (
          <a href={`/summary?child=${row.id}`} class:list={[{ active: row.id === child.id }]}>
            {row.name}
          </a>
        ))}
      </nav>

      {/* ① 習得数の成長曲線 */}
      <section class="card">
        <h2>マスターした九九</h2>
        <p class="headline">
          {totalMastered} こ
          {highlights.masteredThisWeek > 0 && <small>(今週 +{highlights.masteredThisWeek} こ!)</small>}
        </p>
        {curveChart.hasData && totalMastered > 0 ? (
          <svg class="chart" viewBox={`0 0 ${curveChart.width} ${curveChart.height}`} role="img" aria-label="マスター数の推移">
            {curveChart.gridYs.map((y) => (
              <line class="chart-grid" x1="0" y1={y} x2={curveChart.width} y2={y} />
            ))}
            <path class="chart-area" d={curveChart.areaPath} />
            <path class="chart-line" d={curveChart.linePath} />
            {curveChart.lastDot && <circle class="chart-dot" cx={curveChart.lastDot.x} cy={curveChart.lastDot.y} r="5" />}
            {curveChart.lastValue && (
              <text class="chart-value" x={curveChart.lastValue.x} y={curveChart.lastValue.y}>
                {curveChart.lastValue.text}
              </text>
            )}
            {curveChart.xLabels.map((label) => (
              <text class="chart-text" x={label.x} y={curveChart.height - 4} text-anchor={label.anchor}>
                {label.text}
              </text>
            ))}
          </svg>
        ) : (
          <p class="empty">まだデータがたまっていません。ドリルを始めると、ここに成長曲線が現れます。</p>
        )}
        <p class="why">
          「マスター」は<strong>5回連続・すばやく正解</strong>できたときにだけ付く記録です。
          一度マスターした九九は下がらない設計なので、この線は積み上がる一方。がんばりがそのまま残ります。
        </p>
      </section>

      {/* ② 回答スピードの推移 */}
      <section class="card">
        <h2>答えるはやさ</h2>
        {latestSpeed !== null && (
          <p class="headline">
            {latestSpeed} 秒 <small>(直近の平均)</small>
          </p>
        )}
        {speedChart.hasData ? (
          <svg class="chart" viewBox={`0 0 ${speedChart.width} ${speedChart.height}`} role="img" aria-label="週別の平均回答時間">
            {speedChart.gridYs.map((y) => (
              <line class="chart-grid" x1="0" y1={y} x2={speedChart.width} y2={y} />
            ))}
            <path class="chart-area" d={speedChart.areaPath} />
            <path class="chart-line" d={speedChart.linePath} />
            {speedChart.lastDot && <circle class="chart-dot" cx={speedChart.lastDot.x} cy={speedChart.lastDot.y} r="5" />}
            {speedChart.lastValue && (
              <text class="chart-value" x={speedChart.lastValue.x} y={speedChart.lastValue.y}>
                {speedChart.lastValue.text}
              </text>
            )}
            {speedChart.xLabels.map((label) => (
              <text class="chart-text" x={label.x} y={speedChart.height - 4} text-anchor={label.anchor}>
                {label.text}
              </text>
            ))}
          </svg>
        ) : (
          <p class="empty">正解の記録がたまると、はやさの変化がここに出ます。</p>
        )}
        <p class="why">
          答えるまでの時間が短くなっていくのは、「がんばって思い出す」から「そらで言える」に
          変わってきている証拠です。暗記の定着はこの下がり方に表れます。
        </p>
      </section>

      {/* ③ 日々の取り組み量 */}
      <section class="card">
        <h2>とりくみのようす(直近28日)</h2>
        <p class="headline">
          {totalAnswers28d} 回
          {activity.streak > 0 && <small>(ただいま連続 {activity.streak} 日!)</small>}
        </p>
        {activityChart.hasData ? (
          <svg
            class="chart"
            viewBox={`0 0 ${activityChart.width} ${activityChart.height}`}
            role="img"
            aria-label="日別の回答数"
          >
            <line
              class="chart-grid"
              x1="0"
              y1={activityChart.baselineY}
              x2={activityChart.width}
              y2={activityChart.baselineY}
            />
            {activityChart.bars.map((bar) => (
              <rect class="chart-bar" x={bar.x} y={bar.y} width={bar.w} height={bar.h} rx="3" />
            ))}
            {activityChart.xLabels.map((label) => (
              <text class="chart-text" x={label.x} y={activityChart.height - 4} text-anchor={label.anchor}>
                {label.text}
              </text>
            ))}
          </svg>
        ) : (
          <p class="empty">この28日間の記録はまだありません。</p>
        )}
        <p class="why">毎日すこしずつが、暗記のいちばんの近道です。棒がとぎれない日をいっしょに増やしていきましょう。</p>
      </section>

      {/* ④ つまずきポイント */}
      <section class="card">
        <h2>いっしょに練習したいところ</h2>
        {weakFacts.length > 0 ? (
          <ul class="weak-list">
            {weakFacts.map((fact) => (
              <li>
                <span>{fact.label}</span>
                <span class="weak-meta">
                  まちがい {fact.incorrectCount} 回
                  {fact.avgSeconds !== null && ` ・ 平均 ${fact.avgSeconds} 秒`}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">
            {hasAnyData ? 'いま目立ったつまずきはありません。すばらしい!' : 'ドリルを始めると、練習ポイントがここに出ます。'}
          </p>
        )}
        <p class="why">
          まちがいや時間のかかった九九を、まちがいの多い順にならべています。
          おふろやおでかけの時間に、声に出していっしょに唱えるのがおすすめです。
        </p>
      </section>
    </main>
  </body>
</html>
