# このファイルをコピーして .env を作成し、値を埋めてください(.envはgit管理外)
# 値は `npx supabase start` 実行後にターミナルへ表示されるものを使う

# Supabase(ローカル)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# service_role キーはサーバー専用。PUBLIC_ 接頭辞を絶対に付けないこと
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth(親アカウントのログイン用。取得手順は README.md 参照)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
